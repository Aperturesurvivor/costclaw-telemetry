{
  "id": "costclaw-telemetry",
  "name": "CostClaw",
  "description": "Local, cache-aware LLM usage and cost telemetry for OpenClaw.",
  "version": "0.2.0",
  "legacyPluginIds": ["costclaw"],
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "costclaw_status",
      "costclaw_dashboard"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "port": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535,
        "description": "Port for the local dashboard server (default: 3333)"
      }
    }
  }
}
