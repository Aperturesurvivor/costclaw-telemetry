{
  "name": "costclaw-telemetry",
  "version": "0.2.0",
  "description": "Local OpenClaw LLM usage and cost telemetry with cache-aware accounting.",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist/",
    "src/",
    "openclaw.plugin.json",
    "AGENT.md",
    "llms.txt",
    "tsconfig.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": {
      "pluginApi": ">=2026.5.7",
      "minGatewayVersion": "2026.5.7"
    },
    "build": {
      "openclawVersion": "2026.5.7",
      "pluginSdkVersion": "2026.5.7"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "check": "npm test && npm run build && npm pack --dry-run",
    "prepare": "npm run build",
    "dev": "node --import tsx/esm src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.48",
    "better-sqlite3": "13.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "llm-cost-tracking",
    "ai-cost-optimization",
    "llm-monitoring",
    "cost-dashboard",
    "llm-costs",
    "ai-agents",
    "cost-tracking",
    "telemetry"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Aperturesurvivor/costclaw-telemetry#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aperturesurvivor/costclaw-telemetry.git"
  },
  "bugs": {
    "url": "https://github.com/Aperturesurvivor/costclaw-telemetry/issues"
  }
}
